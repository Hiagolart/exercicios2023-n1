{
  "name": "comex-intelligence",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @comex/web dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @comex/db generate",
    "db:migrate": "pnpm --filter @comex/db migrate:dev",
    "db:deploy": "pnpm --filter @comex/db migrate:deploy",
    "ingest": "pnpm --filter @comex/ingest start",
    "test:integration": "pnpm -r --if-present test:integration",
    "test:e2e": "pnpm --filter @comex/web test:e2e",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "typescript": "5.9.3"
  }
}
